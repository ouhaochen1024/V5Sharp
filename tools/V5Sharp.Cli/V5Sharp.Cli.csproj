<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>V5Sharp.Cli</AssemblyName>
    <RootNamespace>V5Sharp.Cli</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\V5Sharp.Core\V5Sharp.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\dist\payload\V5Hook32.dll" Link="payload\V5Hook32.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\dist\payload\V5Hook64.dll" Link="payload\V5Hook64.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\dist\payload\V5Inject32.exe" Link="payload\V5Inject32.exe" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
