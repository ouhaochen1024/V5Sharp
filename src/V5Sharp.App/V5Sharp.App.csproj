<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>V5多开器Pro</AssemblyName>
    <Product>V5多开器Pro</Product>
    <AssemblyTitle>V5多开器Pro</AssemblyTitle>
    <Company>www.yysdjbd.cn</Company>
    <Version>1.1.0</Version>
    <FileVersion>1.1.0</FileVersion>
    <RootNamespace>V5Sharp.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <OutputPath>$(MSBuildThisFileDirectory)..\..\dist\app\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\V5Sharp.Core\V5Sharp.Core.csproj" />
  </ItemGroup>

  <!-- 界面字体：MiSans（小米免费商用字体），编进程序集，不依赖系统安装 -->
  <ItemGroup>
    <EmbeddedResource Include="Fonts\*.otf" />
    <None Include="Fonts\README.txt" />
  </ItemGroup>

  <!-- 把注入模块一起带到输出目录 -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\..\dist\payload\V5Hook32.dll">
      <Link>payload\V5Hook32.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="$(MSBuildThisFileDirectory)..\..\dist\payload\V5Hook64.dll">
      <Link>payload\V5Hook64.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="$(MSBuildThisFileDirectory)..\..\dist\payload\V5Inject32.exe">
      <Link>payload\V5Inject32.exe</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
